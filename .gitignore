# Dependencies
node_modules/

# Local build/minified output
minified-code/

# Test and QA generated artifacts
project/.cache/
project/tests/capture-results/
project/tests/diagnostic-crops/
project/tests/generated/
# Golden baseline screenshots are local QA inputs; never commit large PNG baselines.
project/tests/golden-baselines/**/*.png
project/tests/golden-baselines/**/*.jpg
project/tests/golden-baselines/**/*.jpeg
project/tests/golden-baselines/**/*.webp
project/tests/visual-results/

# Transient QA/research run reports.
# Keep durable summaries in project/tests/real-site-findings.md and docs instead.
project/tests/**/report.md
project/tests/real-site-qa-*.md
project/tests/broad-*.md
project/tests/wide-card-*.md
project/tests/targeted-*.md
project/tests/*research*.md
project/tests/*research*.mjs
project/tests/wide-card-headless-research.mjs

# Competitor research is local investigation material, not release package input.
project/tests/competitor-*/
project/tests/competitor-*.md
project/tests/competitor-*.mjs

# Rendered documentation exports are generated review artifacts.
# Keep the Markdown source of truth in Git instead.
project/docs/*.pdf
project/specs/*.pdf
project/product-tasks/*.pdf

# Local saved real-site HTML dumps for investigation.
# Keep these out of Git; promote small reusable fixtures separately.
project/tests/HTML Complicated Sites/

# Screenshot review generated artifacts.
# Keep only the handoff/readme structure, not run outputs or PNG artifacts.
Screenshots-for-Review/*
!Screenshots-for-Review/README.md
!Screenshots-for-Review/For-Codex/
Screenshots-for-Review/For-Codex/*
!Screenshots-for-Review/For-Codex/incoming/
!Screenshots-for-Review/For-Codex/reviewed/
Screenshots-for-Review/For-Codex/incoming/*
Screenshots-for-Review/For-Codex/reviewed/*
!Screenshots-for-Review/For-Codex/incoming/.gitkeep
!Screenshots-for-Review/For-Codex/reviewed/.gitkeep

# Local machine files
.DS_Store
Old Screenshot extension/

# Secrets and packaged extension artifacts
.env
.env.*
*.cookies*
*.pem
*.key
*.p12
*.crt
*.cer
*.crx
*.zip

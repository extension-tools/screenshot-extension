{
  "name": "screenshot-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node project/tests/validate-extension.mjs && node project/tests/sticky-cleanup-smoke.mjs",
    "visual:baseline": "node project/tests/visual-regression.mjs --update-baseline",
    "visual:test": "node project/tests/visual-regression.mjs",
    "capture:test": "node project/tests/capture-flow.mjs",
    "capture:risk": "CAPTURE_INCLUDE_RISK_FIXTURES=1 node project/tests/capture-flow.mjs",
    "qa:png": "node project/tests/offline-png-qa.mjs",
    "risk:sites": "node project/tests/targeted-risk-sites.mjs",
    "real:qa": "node project/tests/real-site-runner.mjs",
    "build:minified": "node project/scripts/build-minified.mjs",
    "test": "npm run check && npm run visual:test"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.53.0",
    "pngjs": "^7.0.0"
  }
}
